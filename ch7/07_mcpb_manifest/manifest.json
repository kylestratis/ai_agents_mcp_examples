{
  "manifest_version": "0.4",
  "name": "calculator-server",
  "display_name": "Calculator",
  "version": "1.0.0",
  "description": "A calculator MCP server with basic math tools",
  "author": {
    "name": "Kyle Stratis"
  },
  "server": {
    "type": "uv",
    "entry_point": "server/server.py",
    "mcp_config": {
      "command": "uv",
      "args": ["run", "--directory", "${__dirname}", "server/server.py"]
    }
  },
  "compatibility": {
    "platforms": ["darwin", "linux", "win32"],
    "runtimes": {
      "python": ">=3.12"
    }
  },
  "license": "MIT"
}
